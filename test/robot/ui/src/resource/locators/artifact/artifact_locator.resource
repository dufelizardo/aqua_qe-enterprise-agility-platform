*** Comments ***
    Página do artefato e documentos da Iniciativa e da Feature (UX/UI 7.4, 7.6 e 6.6; #63).

*** Variables ***
${CARD_OPEN_LINK}              css=[data-testid="card-open"]
${ARTIFACT_TITLE}              css=[data-testid="artifact-title"]
${ARTIFACT_TAB_BY_TYPE}        css=[data-testid="artifact-tab-{}"]
${DOC_TITLE}                   css=[data-testid="doc-title"]
${DOC_EDIT}                    css=[data-testid="doc-edit"]
${DOC_SECTION_EDITOR}          css=[data-section="{}"] [data-testid="rich-content"]
${DOC_SAVE}                    css=[data-testid="doc-save"]
${DOC_APPROVE}                 css=[data-testid="doc-approve"]
${DOC_STATUS}                  css=[data-testid="doc-status"]
${DOC_VERSION}                 css=[data-testid="doc-version"]
${ARTIFACT_DOC_STATUS_BY_TYPE}    css=[data-testid="artifact-doc-status-{}"]
${ARTIFACT_TAB_OVERVIEW}       css=[data-testid="artifact-tab-overview"]
${ARTIFACT_TITLE_INPUT}        css=[data-testid="artifact-title-input"]
${ARTIFACT_TITLE_SAVE}         css=[data-testid="artifact-title-save"]
${ARTIFACT_FIELD_BY_NAME}      css=[data-testid="artifact-field-{}"]
${ARTIFACT_PERSON_SEARCH}      css=[data-testid="artifact-person-search"]
${ARTIFACT_PERSON_OPTION}      css=[data-testid="artifact-person-option"]:text-is("{}")
${ARTIFACT_BACK}               css=[data-testid="artifact-back"]
